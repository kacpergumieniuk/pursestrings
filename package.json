{
  "name": "pursestrings",
  "version": "0.1.0",
  "description": "PurseStrings: a policy firewall for AI-agent wallets on NEAR. Your agent carries the purse; you hold the strings.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build:contracts": "cd contracts/guard && cargo near build non-reproducible-wasm && cd ../test-token && cargo near build non-reproducible-wasm",
    "test": "vitest run",
    "test:contracts": "cd contracts && cargo test",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/check.ts",
    "testnet:setup": "tsx scripts/testnet-setup.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:sandbox": "tsx scripts/demo.ts --sandbox",
    "owner": "tsx scripts/owner.ts",
    "bot": "tsx scripts/bot.ts",
    "bot:console": "tsx scripts/bot.ts --console",
    "demo:video": "tsx scripts/demo-video.ts",
    "demo:record": "tsx scripts/record-demo.ts",
    "demo:render": "tsx scripts/render-video.ts"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.26",
    "grammy": "^1.46.0",
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "near-sandbox": "^0.3.4",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
