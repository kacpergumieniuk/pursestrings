# Copy to .env (gitignored). Every value is optional.

# RPC override for the risk layer (defaults: FastNEAR public RPC for the chosen network)
# GUARD_RPC_URL=https://rpc.mainnet.fastnear.com
# GUARD_TESTNET_RPC=https://test.rpc.fastnear.com

# Extra known-scam lists (JSON: [{ "type": "account"|"token"|"domain", "value" | "pattern", "reason" }])
# GUARD_SCAM_LIST_PATH=./my-scam-list.json
# GUARD_SCAM_LIST_URL=https://example.org/scam-list.json

# Base/EVM token verdict API (separate service). {chain} and {address} are substituted.
# GUARD_EVM_VERDICT_URL=http://localhost:8787/v1/verdict/{address}?chain={chain}

# Existing mainnet account used as recipient/refund address in NEAR Intents dry-run quotes (nothing executes)
# GUARD_INTENTS_RECIPIENT=intents.near

# Optional LLM brain (any OpenAI-compatible endpoint, e.g. NEAR AI Cloud). Without these the scripted brain is used.
# LLM_BASE_URL=https://cloud-api.near.ai/v1
# LLM_API_KEY=
# LLM_MODEL=

# Telegram bot (npm run bot). Token from @BotFather; owner ids are numeric Telegram user ids (send /whoami to the bot).
# Owner actions sign with the testnet owner key from .guard-local/testnet.json; mainnet is refused.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_IDS=123456789
# GUARD_BOT_POLL_MS=15000
